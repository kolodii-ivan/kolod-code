// code.ikolodiy.com on Cloudflare Workers: a static-assets Worker (no server code).
// The app is a pure static export (next.config.ts `output: "export"`): `npm run build`
// writes the site to ./out, and this Worker serves that directory.
// Releases: CI uploads a version with `wrangler versions upload` and promotes it
// with `wrangler versions deploy` once every check is green (.github/workflows/ci.yml).
// Local preview: `npm run cf:preview` (build + `wrangler dev`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kolod-code",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Next's static export; unknown paths get the exported 404.html with a 404 status.
    "directory": "./out",
    "not_found_handling": "404-page",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // The custom domain creates its own DNS record and certificate; a zone record for the same
  // exact hostname must not exist (the zone's wildcard does not conflict).
  "routes": [{ "pattern": "code.ikolodiy.com", "custom_domain": true }]
}
